# Fixture for the multi-port scope test: the `web` service overrides its
# protocol's single port with a list of ports and a port range, so its
# compiled policy line carries several scopes.

[nodes.n0]
key = "none"
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"
interfaces = [ "in1" ]
in1.netaddr = "1.2.3.4:5000"

[visa_service]
dock_node = "n0"

[trusted_services.default]
cert_path = ""

[trusted_services.hr]
api = "file"
returns_attributes = [ "red -> #user.red", "employee_id -> user.employee_id" ]

[protocols.https]
l4protocol = "TCP"
port = 443

[services.web]
protocol = "https"
port = "443, 4343, 8000-8010"
provider = [[ "user.employee_id", "1233" ]]
