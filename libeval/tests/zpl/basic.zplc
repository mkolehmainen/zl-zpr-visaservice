
[nodes.n0]
key = "none"
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"
interfaces = [ "in1" ]
in1.netaddr = "1.2.3.4:5000"

[visa_service]
dock_node = "n0"

[trusted_services.default]
cert_path = ""

[trusted_services.hr]
api = "file"
returns_attributes = [ "orange -> #user.orange", "red -> #user.red", "green -> #user.green", "content -> service.content", "employee_id -> user.employee_id" ]

[protocols.http]
l4protocol = "TCP"
port = 80

[protocols.ping]
l4protocol = "ICMP6"
icmp_type = "request-response"
icmp_codes = [ 128, 129 ]

[services.database]
protocol = "http"
provider = [[ "user.employee_id", "1233" ]]

[services.pingdb]
protocol = "ping"
provider = [[ "user.employee_id", "1233" ]]
