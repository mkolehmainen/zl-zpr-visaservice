# minimal config so that we can test parsing the RFC zpl

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.hr]
api = "file"
returns_attributes = [ "tint -> device.tint", "color -> user.color", "employee_id -> user.employee_id", "hard -> #device.hardened" ]

[protocols.http]
l4protocol = "TCP"
port = 80

[services.database]
protocol = "http"
provider = [[ "user.employee_id", "1233" ]]

[services.signalService]
protocol = "http"
provider = [[ "user.employee_id", "1234" ]]
