load zpt-test.bin2

# test connect success
connect --ac device.zpr.adapter.cn:bas.zpr.org

# test connect succeeds as an adapter without a matching join policy
connect --ac device.zpr.adapter.cn:bazz.zpr.org

# test that a policy-declared identity attribute joins the builtin CN identity
connect --ac device.zpr.adapter.cn:bas.zpr.org --ac user.bas_id:1233
