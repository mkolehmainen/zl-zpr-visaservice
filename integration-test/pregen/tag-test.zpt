load zpt-test.bin2

# Compiler >= 0.16 emits presence conditions for class specs (#144): user rules
# require user.zpr.authority and device conditions require device.zpr.authority.

set alice user.employee_id:1000
set alice user.color:red
set alice #device.hardened
set alice user.zpr.authority:hr
set alice device.zpr.authority:zpr-bootstrap


set bob user.employee_id:1001
set bob user.color:red
set bob user.zpr.authority:hr
set bob device.zpr.authority:zpr-bootstrap

set carol user.employee_id:1002
set carol #device.hardened
set carol user.zpr.authority:hr
set carol device.zpr.authority:zpr-bootstrap


set web zpr.services:web1
set web user.employee_id:4567
set web user.zpr.authority:hr

# allowed
eval TCP alice > web.80 [S]

# denied - bob not on hardened device
eval TCP bob > web.80 [S]

# denied - carol not color:red
eval TCP carol > web.80 [S]

